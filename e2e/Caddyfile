# The server's Caddy for the end-to-end tests, on plain HTTP: the API's paths
# go to the API, and everything else to the web container (see compose.yaml).
{
	admin off
	auto_https off
}

:8080 {
	@api path /api /api/* /health /openapi.json
	handle @api {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy web:8080
	}
}
